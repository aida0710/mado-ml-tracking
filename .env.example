# 手元の開発用。本番ではMMT_AUTH_MODEをlocal、oidc、hybridのどれかにし、HTTPSで動かす。
MMT_DATABASE_URL=postgresql://mmt@127.0.0.1:55483/mmt
MMT_TEST_DATABASE_URL=postgresql://mmt@127.0.0.1:55483/mmt_test
MMT_HOST=127.0.0.1
MMT_PORT=4182
# local | oidc | hybrid | development。oidcとhybridにはMMT_OIDC_ISSUER_URL、MMT_OIDC_CLIENT_ID、MMT_OIDC_ALLOWED_GROUPSが要る。
MMT_AUTH_MODE=development
# 操作が無い間も含めて、ログインを7日間保つ（秒）。
MMT_AUTH_SESSION_IDLE_SECONDS=604800
MMT_AUTH_SESSION_ABSOLUTE_SECONDS=604800
# expiresAtを省いたときの有効期間（1〜3650日）。明示的にnullを指定すると期限なしになる。
MMT_TOKEN_DEFAULT_LIFETIME_DAYS=365
MMT_PUBLIC_URL=http://127.0.0.1:5182
MMT_WEB_ORIGIN=http://127.0.0.1:5182
# 開発用: LAN・VPN上のページから開発サーバーへ届くようにする。サーバーではfalseのままにする。
MMT_ALLOW_PRIVATE_ORIGINS=true
MMT_DEVELOPMENT_ADMIN_EMAIL=admin@localhost
MMT_ALLOW_SEED=false
MMT_ALLOW_LOCAL_EXECUTOR=false
MMT_ARTIFACT_FILESYSTEM_ROOT=./var/artifacts
# docker composeのときだけ: 画面から追加するファイルシステムの保存先に使うホストのディレクトリ。
# APIとpreviewのコンテナに同じパスで見せる。COMPOSE_FILEでcompose.filesystem-storage.ymlを有効にし
# （compose.override.ymlを使うなら一覧に残す）、uid 1000用にディレクトリを作る。
# COMPOSE_FILE=compose.yml:compose.filesystem-storage.yml
# MMT_FILESYSTEM_STORAGE_DIR=/srv/mmt/storage
# Artifact 1つの大きさの上限（既定200 GiB）。アップロードのリクエストのタイムアウトは0で無効になる。
# 無通信のタイムアウトの単位はミリ秒。
MMT_ARTIFACT_MAX_BYTES=214748364800
MMT_UPLOAD_REQUEST_TIMEOUT_MS=0
MMT_UPLOAD_IDLE_TIMEOUT_MS=120000
# 削除したArtifactの実体を、ガベージコレクタが消すまで残しておく日数。
MMT_ARTIFACT_DELETE_GRACE_DAYS=7
# server-infoとmpu/*を通したMLflowのマルチパートアップロード。ダウンロードはfalseのままにする
# （署名付きURLを出さない）。
MMT_MLFLOW_MULTIPART_UPLOADS=true
MMT_MLFLOW_MULTIPART_DOWNLOADS=false
# MLflowのmpu/completeが503を返すまでに検証を待つ時間（SDKのタイムアウト120秒より短くする）。
MMT_UPLOAD_FINALIZE_WAIT_MS=100000
# DBに置く保存先のsecretを暗号化する鍵。32バイトのbase64（`openssl rand -base64 32`で作る）。
# 無いと、secretを持つS3の保存先を/adminから作れない。
MMT_STORAGE_SECRET_KEY=
# DBに置くwebhookのフックのsecretを暗号化する鍵。32バイトのbase64（`openssl rand -base64 32`）。
# 無いと、triggerがwebhookのフックを作れず、保存済みのものも検証できない。
MMT_HOOK_SECRET_KEY=
# off | enforce。enforceでは、Dockerイメージを使うJob・Task・ルール・フックを、registryのmanifestから
# 読んだイメージがコンピュータのCPU（cpuArch）向けにビルドされているときだけ保存する。
MMT_IMAGE_PLATFORM_CHECK=off
# その確認で非公開のイメージを読むための認証情報。このregistry（host[:port]。Docker Hubはdocker.io）
# にだけ送る。3つとも設定するか、どれも設定しない。ほかのregistryには匿名で問い合わせる。
MMT_REGISTRY_HOST=
MMT_REGISTRY_USERNAME=
MMT_REGISTRY_PASSWORD=
# 検索結果のCSV出力1回の行数の上限（50000）。超えた分は切り捨て、切り捨てたことを示す。
MMT_CSV_EXPORT_MAX_ROWS=50000
# レポートの1つのrevisionが保存できる、固定した（snapshot）ブロックのデータの合計バイト数。
MMT_REPORT_SNAPSHOT_MAX_BYTES=52428800
# Runごとに既定で一覧に出すcheckpointの数。古いものは隠すだけで（retained=false）、Artifactは残る。
MMT_CHECKPOINT_KEEP_COUNT=5

# AuthentikのOIDC provider。callbackはこの値と完全に一致させる: {MMT_PUBLIC_URL}/api/auth/callback
MMT_OIDC_ISSUER_URL=
MMT_OIDC_CLIENT_ID=
MMT_OIDC_CLIENT_SECRET=
# ログイン画面のSSOボタンの表示名。
MMT_OIDC_LABEL=Authentik
MMT_OIDC_SCOPES=openid profile email offline_access
# trueのときだけ、SSOのログインを同じメールアドレスのローカルユーザーに結び付ける。
# 特権を持つローカルユーザーは結び付けない。
MMT_OIDC_AUTO_LINK_VERIFIED_EMAIL=false
# oidcとhybridでは必須。これらのグループに属さないユーザーはログインできない。
MMT_OIDC_ALLOWED_GROUPS=mmt-users,mmt-admins
# グループ → 全体のrole（admin | user）。最も強いroleを採る。対応の無いユーザーはMMT_OIDC_DEFAULT_ROLEになる。
MMT_OIDC_ROLE_MAPPING_JSON={"mmt-admins":"admin","mmt-users":"user"}
MMT_OIDC_DEFAULT_ROLE=user
MMT_OIDC_ALLOW_INSECURE_HTTP=false
# oidcとhybridでは必須。32バイトのbase64（openssl rand -base64 32）で、MMT_STORAGE_SECRET_KEYとは
# 別の値にする。グループの再確認のためにSSOのsessionで持つIdPのtokenを暗号化する。
MMT_SESSION_ENCRYPTION_KEY=
# SSOのsessionでUserInfoを確認する間隔（秒）。Providerのscope mappingsでoffline_accessも有効にする。
MMT_OIDC_RECHECK_SECONDS=60
# 最後のグループ同期からこれより長くたつと、SSOユーザーのAPI tokenは止まる（401 identity_sync_required）。
MMT_OIDC_TOKEN_SYNC_MAX_AGE_SECONDS=604800

# MMT_S3_BUCKETを設定すると、S3を保存先として選べるようになる。
# 認証情報は、ここに書く代わりにAWS SDKの既定のprovider chainから取ってもよい。
MMT_S3_BUCKET=
MMT_S3_ENDPOINT=
MMT_S3_REGION=us-east-1
MMT_S3_PREFIX=mado-model-tracking
MMT_S3_FORCE_PATH_STYLE=false
MMT_S3_ACCESS_KEY_ID=
MMT_S3_SECRET_ACCESS_KEY=

# 通知先はこれらの変数の名前を指定する（MMT_NOTIFICATION_の前置きが必須）。値はDBに入れない。
# 下は名前の例。SlackのIncoming WebhookのURL、webhookのURL、webhookの署名用のsecretを設定し、
# 設定 > 通知で名前を登録する。
MMT_NOTIFICATION_SLACK_URL=
MMT_NOTIFICATION_WEBHOOK_URL=
MMT_NOTIFICATION_WEBHOOK_SECRET=
# 両方を設定したときだけ、メールの通知先へ送る。smtp://はサーバーが対応していればSTARTTLSを使い、
# smtps://はTLSで接続する。URLにuser:passwordを含めてもよい。例: mado ML Tracking <mmt@example.com>
MMT_SMTP_URL=
MMT_SMTP_FROM=

# site launcher（docker compose --profile launcher。deploy/sites/README.md）。APIのURLとtokenファイルは
# ここでなく、設定ディレクトリのlauncher.tomlに書く。siteは画面で設定し、launcherが作るSSH鍵は
# 状態のvolumeに残る。
MMT_LAUNCHER_CONFIG_DIR=./var/launcher-config
MMT_LAUNCHER_SECRETS_DIR=./var/launcher-secrets
MMT_LAUNCHER_UID=10002
MMT_LAUNCHER_GID=10002
# Jobのリポジトリとコンテナレジストリを置くForgejo（docker compose --profile forge。
# deploy/forgejo/README.md）。SECRET_KEYは専用のファイルから読み、このファイルには書かない。
MMT_FORGEJO_DOMAIN=forge.example.org
MMT_FORGEJO_HTTP_PORT=3000
MMT_FORGEJO_SSH_PORT=2222
MMT_FORGEJO_SSH_BIND=127.0.0.1
MMT_FORGEJO_SSH_DOMAIN=
MMT_FORGEJO_SECRET_KEY_FILE=./var/forgejo-secret-key

# APIが読み取り専用でリポジトリを表示するときのSSHの認証情報（任意）。
# どちらもAPIサーバー上のパス。コンピュータでのGitの実行には、コンピュータ側の認証情報を使う。
MMT_GIT_SSH_KEY_PATH=
MMT_GIT_KNOWN_HOSTS_PATH=

# 内蔵のmado S3 Data Catalog連携の認証情報には、専用のAES-256の鍵（32バイトの乱数のbase64）を
# 使う。連携が未設定か無効のうちは省いてよい。再起動しても同じ鍵を使い続ける。
MMT_PLUGIN_SECRET_KEY=

# プレビューのworker: コンパイルしたAPIのコードとffmpeg/ffprobe。APIのイメージにメディアのデコーダを
# 入れないよう、Dockerfile.apiと分けている（apps/api/src/previewWorker.tsを参照）。build段階は
# Dockerfile.apiと同じ。固定したdigestはDependabotが更新する。
# node:22-bookworm-slim
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api ./apps/api
COPY apps/web/package.json ./apps/web/package.json
COPY packages ./packages
RUN npm ci && npm run build --workspace @mmt/api \
  && rm -rf node_modules && npm ci --omit=dev --workspace @mmt/api \
  && rm -rf apps/api/src apps/api/test apps/api/tsconfig*.json packages/*/src packages/*/tsconfig*.json

# node:22-bookworm-slim
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS release
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps ./apps
COPY --from=build /app/packages ./packages
RUN mkdir -p /app/var/artifacts /app/var/preview-work && chown -R node:node /app/var
ENV NODE_ENV=production MMT_PREVIEW_WORK_DIR=/app/var/preview-work
USER node
# `npm run preview-worker --workspace @mmt/api`と同じ作業ディレクトリ。
WORKDIR /app/apps/api
CMD ["node", "--conditions=compiled", "dist/previewWorker.js"]

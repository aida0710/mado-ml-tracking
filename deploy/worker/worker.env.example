# worker 1台分の環境変数ファイル（mado-tracking-worker@<worker-id>.service）。
# `mado-tracking-worker install`がこのファイルを書く。手で書くときは:
#   install -m 600 /dev/null /etc/mado-tracking-worker/<worker-id>.env   （user unitでは~/.config/mado-tracking-worker/）
# 単純なKEY=valueの行だけを書く。引用符・$・バックスラッシュは使わない。

# APIのoriginか.../api。コンピュータからもこのURLに届く必要がある
# （127.0.0.1はworkerのホストしか指さない）。
MMT_API_URL=https://tracking.example.internal
# 再起動や更新をしても変えない。systemdのinstance名にも同じ値を使う。
MMT_WORKER_ID=gpu-host-1
# コンピュータのIDをカンマ区切りで書く。空なら、tokenとAPIが許すすべてのコンピュータ。
MMT_WORKER_TARGET_IDS=
# 実行中のJobのjournal。入れ直しても残す。消すと実行中のJobを放棄する。
MMT_WORKER_STATE_DIR=/var/lib/mado-tracking-worker/gpu-host-1
# read・worker:execute・artifacts:writeを持つService Accountのtoken。コマンドラインでなくエディタで貼る。
MMT_API_TOKEN=

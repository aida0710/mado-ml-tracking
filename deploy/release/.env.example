# 16進のパスワードを作る: openssl rand -hex 24
MMT_POSTGRES_PASSWORD=
# base64の鍵を作る: openssl rand -base64 32
MMT_STORAGE_SECRET_KEY=

AUTH_MODE=local
MMT_PUBLIC_URL=https://tracking.example.com
MMT_WEB_ORIGIN=https://tracking.example.com
MMT_ALLOW_PRIVATE_ORIGINS=false
MMT_TRUSTED_PROXY_HOPS=1
AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_ABSOLUTE_SECONDS=604800

# SSOは任意。使うならAUTH_MODEをoidcかhybridにし、次の値を設定する。
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_GROUPS=mmt-users,mmt-admins
OIDC_ROLE_MAPPING_JSON={"mmt-admins":"admin","mmt-users":"user"}
OIDC_SCOPES=openid email profile offline_access
# 上とは別のbase64の鍵: openssl rand -base64 32
MMT_SESSION_ENCRYPTION_KEY=

# workerのprofile（任意）。tokenファイルはsecretとしてマウントする。
MMT_WORKER_API_URL=http://api:4182
MMT_WORKER_ID=compose-worker-1
MMT_WORKER_TARGET_IDS=
MMT_WORKER_TOKEN_FILE=./var/worker-token
MMT_WORKER_SSH_DIR=./var/worker-ssh

# launcherのprofile（任意）。deploy/sites/examples/launcher.tomlを参照。
MMT_LAUNCHER_CONFIG_DIR=./var/launcher-config
MMT_LAUNCHER_SECRETS_DIR=./var/launcher-secrets

# ファイルシステムのマウント（任意）。ディレクトリを先に作り、uid 1000が書き込めるようにする。
# COMPOSE_FILE=compose.yml:compose.filesystem-storage.yml
# MMT_FILESYSTEM_STORAGE_DIR=/srv/mmt/storage

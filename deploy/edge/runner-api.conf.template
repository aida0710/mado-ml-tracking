# runner 用 API の公開 hostname の edge nginx の server block。LAN の外の計算ノードの runner は、
# Job token（mado_mtj_）でこれを通って tracking に届く。通すのは Job token で使える route と、署名付きの
# フックの webhook だけ。画面・SSO・管理 API とほかの API の route は intranet の hostname に残す。
# deploy/edge/README.md を参照。
#
# nginxイメージのtemplateの手順（/etc/nginx/templates/*.template、envsubst）で値を埋める:
#   MMT_RUNNER_API_HOSTNAME   公開するhostname。Let's Encryptの証明書の名前にも使う
#   MMT_RUNNER_API_UPSTREAM   trackingのwebのnginxのhost:port（composeなら127.0.0.1:5182）。
#                             そのnginxが/api/をAPIへ転送する
# nginx自身の$変数がそのまま残るよう、置き換えはこれらの名前に限る
# （NGINX_ENVSUBST_FILTER=^MMT_RUNNER_API_）。下のmapとzoneはhttpブロックに属する。httpブロックが
# conf.d/*.confを読み込む。

# Job token は "Authorization: Bearer mado_mtj_<base64url>"。API token（mado_mt_）と session は通さない。
map $http_authorization $mmt_runner_job_token {
    default                                 0;
    "~^Bearer mado_mtj_[A-Za-z0-9_-]+$"     1;
}

# nginxとAPIで区切り方が変わりうる生のパス: エンコードした'.'・'/'・'\'、バックスラッシュ
# （URLのparserは'/'と読む）、空のセグメント、ドットのセグメント。SDKとrunnerはこれらを送らない。
# 調べるのは'?'より前だけ。
map $request_uri $mmt_runner_ambiguous_path {
    default                             0;
    "~*^[^?]*%(2e|2f|5c)"               1;
    "~^[^?]*\\\\"                       1;
    "~^[^?]*//"                         1;
    "~^[^?]*/\.\.?(/|\?|$)"             1;
}

# メソッドと正規化したパス（$uri）ごとのroute。"job"の行はapps/api/src/http/jobTokenGuard.tsの
# Job tokenの決まりとrunnerのrouteに従う。指定されたProject・Job・Runがtoken自身のものかは、
# 引き続きAPIが確かめる。それ以外はここでは公開しない。
map "$request_method $uri" $mmt_runner_route {
    default                                                                             "";
    # ヘルスチェック（API では /api の外）と、token の説明（scope、Job token かどうか）。
    "~^(GET|HEAD) /healthz$"                                                            job;
    "~^(GET|HEAD) /api/auth/token$"                                                     job;
    # Project内の読み取り: 入力、ファイル、上流のRun、子Job、アップロードセッション。
    "~^(GET|HEAD) /api/projects/[^/]+(/.*)?$"                                           job;
    "~^POST /api/projects/[^/]+/runs/search$"                                           job;
    "~^POST /api/projects/[^/]+/media/compare$"                                         job;
    # runnerのプロトコルと、driver Jobの子Job。
    "~^POST /api/projects/[^/]+/jobs/[^/]+/runner/(start|heartbeat|logs|metrics|outputs|finish)$" job;
    "~^POST /api/projects/[^/]+/jobs/[^/]+/children$"                                   job;
    # Job自身のRunへの書き込み: Run、メトリクス、ログ、メディア、checkpoint、Artifact。
    "~^PATCH /api/projects/[^/]+/runs/[^/]+$"                                           job;
    "~^POST /api/projects/[^/]+/runs/[^/]+/(metrics|logs|media|checkpoints)$"           job;
    "~^PUT /api/projects/[^/]+/runs/[^/]+/artifacts$"                                   job;
    "~^POST /api/projects/[^/]+/artifact-uploads$"                                      job;
    "~^PUT /api/projects/[^/]+/artifact-uploads/[^/]+/parts/[^/]+$"                     job;
    "~^POST /api/projects/[^/]+/artifact-uploads/[^/]+/complete$"                       job;
    "~^DELETE /api/projects/[^/]+/artifact-uploads/[^/]+$"                              job;
    # Runから登録する出力: モデルとそのバージョン、データセットバージョン。
    "~^POST /api/projects/[^/]+/models$"                                                job;
    "~^POST /api/projects/[^/]+/(models|datasets)/[^/]+/versions$"                      job;
    # MLflow互換API。JobのコードはMLFLOW_TRACKING_URIを通してここに届く。
    # マルチパートのpartのアップロード（mlflow-artifacts/mpu）はAuthorizationを持たないので、
    # 閉じたままにする。
    "~^(GET|HEAD) /api/mlflow/projects/[^/]+/.+$"                                       job;
    "~^POST /api/mlflow/projects/[^/]+/api/2\.0/mlflow/runs/(update|log-parameter|log-metric|log-batch|set-tag|delete-tag|log-inputs|outputs|log-model|search)$" job;
    "~^POST /api/mlflow/projects/[^/]+/api/2\.0/mlflow/(experiments/search|model-versions/create|registered-models/create|registered-models/get-latest-versions|logged-models|logged-models/search)$" job;
    "~^PATCH /api/mlflow/projects/[^/]+/api/2\.0/mlflow/logged-models/[^/]+(/tags)?$"  job;
    "~^DELETE /api/mlflow/projects/[^/]+/api/2\.0/mlflow/logged-models/[^/]+/tags/[^/]+$" job;
    "~^POST /api/mlflow/projects/[^/]+/api/2\.0/mlflow/logged-models/[^/]+/params$"    job;
    "~^PUT /api/mlflow/projects/[^/]+/api/2\.0/mlflow-artifacts/artifacts/.+$"          job;
    # フックのwebhookはtokenを持たない。APIが送信元の署名（X-Hub-Signature-256か
    # X-MMT-Signature）を確かめる。
    "~^POST /api/hooks/[^/]+/webhook$"                                                  webhook;
}

# Job tokenの無いJobのrouteなら1。
map "$mmt_runner_route:$mmt_runner_job_token" $mmt_runner_token_missing {
    default                             0;
    "job:0"                             1;
}

# webhookにはAuthorizationヘッダーを決して転送しないので、tokenが一緒に通ることはない。
map $mmt_runner_route $mmt_runner_forwarded_authorization {
    default                             $http_authorization;
    webhook                             "";
}

limit_req_zone $binary_remote_addr zone=mmt_runner_webhooks:10m rate=10r/s;

# query文字列はアクセスログに残さない。
log_format mmt_runner_no_query '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                               '$status $body_bytes_sent $request_time "$http_user_agent"';

# 平文のHTTPはLet's Encryptにだけ答える。APIを出すこともリダイレクトすることもしない。http://で
# 送られたJob tokenは既に平文でネットワークを通っているので、runnerのURLはhttps://で書く必要がある。
server {
    listen 80;
    listen [::]:80;
    server_name ${MMT_RUNNER_API_HOSTNAME};
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 403;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${MMT_RUNNER_API_HOSTNAME};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${MMT_RUNNER_API_HOSTNAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MMT_RUNNER_API_HOSTNAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MmtRunnerTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;
    access_log /dev/stdout mmt_runner_no_query;
    # 下のJSONのエラーの本文用。APIの応答は自分のtypeのまま。
    default_type application/json;

    # 任意: siteの送信元アドレス（webhookを使うならその送信元も）だけを受け付ける。
    # allow 203.0.113.0/24;
    # deny all;

    # 本文はAPIへそのまま流す。上限（MMT_ARTIFACT_MAX_BYTES、JSONの大きさ）はAPIが当て、エラーも
    # APIが返す。タイムアウトは、intranetのhostnameと同じく無通信の間隔。
    client_max_body_size 0;
    client_body_timeout 120s;
    client_header_timeout 30s;

    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    # 最後のバイトのあとAPIが大きなArtifactを保存し終えるのと、long pollを待つ。
    proxy_read_timeout 3600s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Connection "";
    proxy_set_header Authorization $mmt_runner_forwarded_authorization;
    # このhostnameでは、ブラウザのsessionを一切認めない。
    proxy_set_header Cookie "";

    if ($mmt_runner_ambiguous_path) {
        return 400 '{"error":"this path is not accepted","code":"invalid_path"}\n';
    }

    # API のヘルスチェックも、公開 hostname では Job token を持つ runner にだけ答える。
    location = /healthz {
        if ($mmt_runner_route = "") {
            return 404 '{"error":"API route not found","code":"not_found"}\n';
        }
        if ($mmt_runner_token_missing) {
            return 401 '{"error":"this hostname accepts only Job tokens","code":"job_token_required"}\n';
        }
        proxy_pass http://${MMT_RUNNER_API_UPSTREAM};
    }

    location /api/ {
        if ($mmt_runner_route = "") {
            return 404 '{"error":"API route not found","code":"not_found"}\n';
        }
        if ($mmt_runner_token_missing) {
            return 401 '{"error":"this hostname accepts only Job tokens","code":"job_token_required"}\n';
        }
        proxy_pass http://${MMT_RUNNER_API_UPSTREAM};
    }

    # webhookの本文の上限256 KiB（HOOK_PAYLOAD_MAX_BYTES）とフックごとの起動の制限はAPIが持つ。
    # edgeは大きさと送信元ごとの頻度だけを抑える。
    location ~ ^/api/hooks/[^/]+/webhook$ {
        if ($mmt_runner_route = "") {
            return 404 '{"error":"API route not found","code":"not_found"}\n';
        }
        client_max_body_size 1m;
        limit_req zone=mmt_runner_webhooks burst=20 nodelay;
        limit_req_status 429;
        proxy_read_timeout 30s;
        proxy_pass http://${MMT_RUNNER_API_UPSTREAM};
    }

    location / {
        return 404 '{"error":"API route not found","code":"not_found"}\n';
    }
}

{
  "name": "@mmt/api",
  "version": "0.5.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "rm -rf dist && tsc -b tsconfig.build.json && cp -R src/db/migrations dist/db/",
    "start": "node --conditions=compiled --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --conditions=compiled --env-file-if-exists=../../.env dist/migrate.js",
    "db:migrate:dev": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "preview-worker": "node --conditions=compiled --env-file-if-exists=../../.env dist/previewWorker.js",
    "bootstrap-admin": "node --conditions=compiled --env-file-if-exists=../../.env dist/scripts/bootstrapAdmin.js",
    "backfill-run-media": "node --conditions=compiled --env-file-if-exists=../../.env dist/scripts/backfillRunMedia.js",
    "test": "vitest run test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@mmt/contracts": "0.5.1",
    "@mmt/platform": "0.5.1",
    "argon2": "^0.45.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.18"
  }
}
